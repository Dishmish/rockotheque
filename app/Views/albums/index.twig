<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rockothèque — Albums</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>Les albums de Rockothèque</h1>

    <p><a href="/">Accueil</a></p>
    <p><a href="/albums/create">Ajouter un album</a></p>

{% if created %}
    <p>L’album a été ajouté avec succès.</p>
{% endif %}
{% if updated %}
    <p>L’album a été modifié avec succès.</p>
{% endif %}
{% if deleted %}
    <p>L’album a été supprimé avec succès.</p>
{% endif %}

    {% for album in albums %}
    
    <article>
            <h2>{{ album.title }}</h2>

            <p><strong>Artiste :</strong> {{ album.artists }}</p>
            <p><strong>Genre :</strong> {{ album.genre }}</p>
            <p><strong>Année :</strong> {{ album.release_year }}</p>

            <p>
                <strong>Note moyenne :</strong>
                {% if album.average_rating is not null %}
                    {{ album.average_rating }}/5
                {% else %}
                    Aucune évaluation
                {% endif %}
            </p>

            <p>{{ album.description }}</p>
            <form
    action="/albums/{{ album.id }}/delete"
    method="post"
    onsubmit="return confirm('Voulez-vous vraiment supprimer cet album ?');"
>
    <input
        type="hidden"
        name="csrf_token"
        value="{{ csrf_token }}"
    >

    <button type="submit">Supprimer</button>
</form>
<p>
    <a href="/albums/{{ album.id }}">Voir les détails et les avis</a>
</p>
<p>
    <a href="/albums/{{ album.id }}/edit">Modifier</a>
</p>
        </article>
    {% else %}
        <p>Aucun album pour le moment.</p>
    {% endfor %}
</body>
</html>
