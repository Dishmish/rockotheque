<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ album.title }} — Rockothèque</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>Rockothèque</h1>

        <nav>
            <a href="/">Accueil</a>
            <a href="/albums">Les albums</a>
        </nav>
    </header>

    <main>
        <article>
            <h2>{{ album.title }}</h2>

            <p>
                <strong>Année :</strong>
                {{ album.release_year }}
            </p>

            <h3>Artistes</h3>

            <ul>
                {% for artist in artists %}
                    <li>{{ artist.name }} — {{ artist.role }}</li>
                {% else %}
                    <li>Aucun artiste associé.</li>
                {% endfor %}
            </ul>

            <p>{{ album.description }}</p>
        </article>

        <section>
        {% if review_created %}
    <p>L’avis a été ajouté avec succès.</p>
{% endif %}

{% if errors %}
    <div>
        <h3>Veuillez corriger les erreurs :</h3>
        <ul>
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

<h2>Ajouter un avis</h2>

<form action="/albums/{{ album.id }}/reviews" method="post">
    <input
        type="hidden"
        name="csrf_token"
        value="{{ csrf_token }}"
    >

    <p>
        <label for="reviewer_name">Votre nom</label><br>
        <input
            type="text"
            id="reviewer_name"
            name="reviewer_name"
            value="{{ form.reviewer_name }}"
            maxlength="100"
            required
        >
    </p>

    <p>
        <label for="rating">Note</label><br>
        <select id="rating" name="rating" required>
            <option value="">Choisir une note</option>

            {% for note in 5..1 %}
                <option
                    value="{{ note }}"
                    {% if form.rating == note %}selected{% endif %}
                >
                    {{ note }}/5
                </option>
            {% endfor %}
        </select>
    </p>

    <p>
        <label for="comment">Commentaire</label><br>
        <textarea
            id="comment"
            name="comment"
            rows="5"
            maxlength="5000"
            required
        >{{ form.comment }}</textarea>
    </p>

    <button type="submit">Publier l’avis</button>
</form>
            <h2>Avis publiés</h2>

            {% for review in reviews %}
                <article>
                    <h3>{{ review.reviewer_name }}</h3>

                    <p>
                        <strong>Note :</strong>
                        {{ review.rating }}/5
                    </p>

                    <p>{{ review.comment }}</p>

                    <p>
                        <small>{{ review.created_at }}</small>
                    </p>
                </article>
            {% else %}
                <p>Aucun avis pour cet album.</p>
            {% endfor %}
        </section>
    </main>
</body>
</html>